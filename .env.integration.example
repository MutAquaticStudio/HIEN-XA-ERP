# Dedicated Supabase staging only. Never put real credentials in this tracked example.
ERP_RUN_INTEGRATION_TESTS=1
ERP_TEST_DATABASE_CONFIRMATION=hien-xa-staging
ERP_UAT_FIXTURE_CONFIRMATION=UAT-UXV2
ERP_TEST_DATABASE_URL=postgresql://postgres.STAGING_PROJECT_REF:STAGING_DATABASE_PASSWORD@REGION.pooler.supabase.com:5432/postgres
SUPABASE_TEST_URL=https://STAGING_PROJECT_REF.supabase.co
SUPABASE_TEST_ANON_KEY=replace-with-staging-anon-key
SUPABASE_TEST_SERVICE_ROLE_KEY=replace-with-staging-service-role-key
SUPABASE_TEST_PROJECT_REF=replacewithstagingref
SUPABASE_PRODUCTION_PROJECT_REF=replacewithproductionref

# Fixed non-PII usernames; use a different random 20+ character password per role.
E2E_OWNER_USERNAME=uat.uxv2.owner
E2E_OWNER_PASSWORD=replace-with-unique-random-password-1
E2E_ACCOUNTANT_USERNAME=uat.uxv2.accountant
E2E_ACCOUNTANT_PASSWORD=replace-with-unique-random-password-2
E2E_WAREHOUSE_USERNAME=uat.uxv2.warehouse
E2E_WAREHOUSE_PASSWORD=replace-with-unique-random-password-3
E2E_DISPATCHER_USERNAME=uat.uxv2.dispatcher
E2E_DISPATCHER_PASSWORD=replace-with-unique-random-password-4
E2E_DRIVER_USERNAME=uat.uxv2.driver
E2E_DRIVER_PASSWORD=replace-with-unique-random-password-5
E2E_WORKER_USERNAME=uat.uxv2.worker
E2E_WORKER_PASSWORD=replace-with-unique-random-password-6
E2E_CUSTOMER_USERNAME=uat.uxv2.customer
E2E_CUSTOMER_PASSWORD=replace-with-unique-random-password-7
E2E_SUPPLIER_USERNAME=uat.uxv2.supplier
E2E_SUPPLIER_PASSWORD=replace-with-unique-random-password-8
