{
  "name": "vlxd-operations-system",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:cloudflare-integration": "vitest run --config vitest.cloudflare-integration.config.ts",
    "check": "npm run typecheck && npm run test",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test tests/e2e/public-ux.spec.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --env staging",
    "cf:upload:staging": "opennextjs-cloudflare build && opennextjs-cloudflare upload --env staging",
    "cf:deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging",
    "cf:deploy:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "cf:typegen": "wrangler types --env staging --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:d1:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "cf:d1:migrate:production": "wrangler d1 migrations apply DB --env production --remote"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.101.2",
    "@types/web-push": "^3.6.4",
    "lucide-react": "^1.24.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "read-excel-file": "^6.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postgres": "^3.4.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
