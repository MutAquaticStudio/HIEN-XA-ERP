# Required before the first start when .data/identity.json does not exist.
ERP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ERP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-12-character-password
ERP_BOOTSTRAP_ADMIN_NAME=Chu cua hang
ERP_OWNER_RECOVERY_TOKEN=replace-with-a-long-owner-recovery-token

# At least 32 random characters. Never commit the real value.
ERP_SESSION_SECRET=replace-with-at-least-32-random-characters

# Production-only URL and Server Action host allow-list.
NEXT_PUBLIC_APP_URL=https://erp.example.com
ERP_ALLOWED_ORIGINS=erp.example.com

# Maintenance-window gate. Set to read_only only after the user-facing notice
# is active and before the final production cutover snapshot.
ERP_MAINTENANCE_MODE=off

# Server-only Supabase persistence for Vercel and other cloud runtimes.
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser or commit a real key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-supabase-service-role-key

# Set true only when every request is behind a trusted proxy that overwrites
# x-forwarded-for/x-real-ip/cf-connecting-ip.
ERP_TRUST_PROXY_HEADERS=false

# Optional production map style for the delivery tracking pages. The local
# fallback uses OpenStreetMap raster tiles; configure a managed provider before
# production usage.
NEXT_PUBLIC_MAP_STYLE_URL=https://maps.example.com/style.json

# Optional local development path for append-only delivery tracking data.
VLXD_TRACKING_DATA_FILE=.data/delivery-tracking.json
