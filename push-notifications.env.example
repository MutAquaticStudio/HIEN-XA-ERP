# Web Push VAPID. Generate one key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:owner@example.com

# Optional: keep the notification store outside the repository working tree.
# VLXD_PUSH_DATA_FILE=D:\secure-data\push-notifications.json
